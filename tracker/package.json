{
  "name": "statustracker4-tracker",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown src/main.ts --file dist/tracker.js",
    "dev": "node src/main.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint ${@:-.}",
    "lint:fix": "eslint --fix ${@:-.}",
    "lint:sarif": "eslint -f @_7d/eslint-formatter-sarif --fix ${@:-.} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tsconfig/strictest": "2.0.8",
    "consola": "3.4.2",
    "echarts": "6.1.0",
    "kysely": "0.29.6",
    "node-cron": "4.6.0",
    "pg": "8.23.0",
    "shared": "workspace:../shared",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "rolldown": "1.2.9"
  },
  "overrides": {
    "readdir-glob": "3.0.0",
    "glob": "13.0.6"
  },
  "packageManager": "pnpm@12.5.1"
}
