amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Pnpm.pkl"
import "package://github.com/iiiii7d/hk/releases/download/v2.8.0-7/hk@2.8.0-7#/Misc.pkl"

local init = new Step {
    check = "pnpm i && cd viewer && pnpm run postinstall"
    exclusive = true
}

local formatters = new Mapping<String, Step> {
    ["prettier"] = (Pnpm.pnpm_format) {
        workspace_indicator = "pnpm-workspace.yaml"
    }
}
local linters = new Mapping<String, Step> {
    ["eslint"] = (Pnpm.pnpm_lint) {
        workspace_indicator = "pnpm-workspace.yaml"
    }
    ["zizmor"] = Misc.zizmor
    ["actionlint"] = Misc.actionlint
    ["poutine"] = Misc.poutine
    ["hadolint"] = (Misc.hadolint) {
        glob = "**/{*.,}Dockerfile*"
    }
}
local type_checkers = new Mapping<String, Step> {
    ["tsc"] = Pnpm.pnpm_type_check
}
local sarif = new Mapping<String, Step> {
    ["mkdir"] = Misc.mkdir_sarif(".sarif")
    ["eslint"] = (Pnpm.pnpm_lint_sarif(".sarif")) {
        workspace_indicator = "pnpm-workspace.yaml"
    }
    ["zizmor"] = Misc.zizmor_sarif(".sarif")
    ["actionlint"] = Misc.actionlint_sarif(".sarif")
    ["poutine"] = Misc.poutine_sarif(".sarif")
    ["hadolint"] = (Misc.hadolint_sarif(".sarif")) {
        check = (super.check) {
            command = super.command.replaceAll("Dockerfile", "**/{*.,}Dockerfile")
        }
    }
    ...type_checkers
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["fix"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["check"] {
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
            ...linters
            ...type_checkers
        }
    }
    ["format"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...formatters
        }
    }
    ["sarif"] {
        fix = true
        steps = new Mapping<String, Step | Group> {
            ["init"] = init
            ...sarif
        }
    }
}
