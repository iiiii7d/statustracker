{
  "name": "statustracker4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "type-check": "nuxt typecheck",
    "lint": "eslint ${@:-.}",
    "lint:fix": "eslint --fix ${@:-.}",
    "lint:sarif": "eslint -f eslint-formatter-sarif --fix ${@:-.} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}",
    "db:up": "docker-compose -f pg-compose.yml up -d",
    "db:down": "docker-compose -f pg-compose.yml down",
    "db:psql": "docker-compose -f pg-compose.yml exec postgres psql -U postgres -d statustracker4",
    "db:logs": "docker-compose -f pg-compose.yml logs",
    "gen-licenses": "pnpm licenses ls --long -P > public/licenses.txt"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.121",
    "@internationalized/date": "3.12.3",
    "@nuxt/ui": "4.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@vueuse/nuxt": "14.4.0",
    "canvas": "3.2.3",
    "consola": "3.4.2",
    "echarts": "6.1.0",
    "kysely": "0.29.4",
    "node-cron": "4.6.0",
    "nuxt": "4.5.2",
    "pg": "8.22.0",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "vue": "3.5.41",
    "vue-echarts": "8.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nuxt/eslint": "1.16.0",
    "@types/pg": "8.21.0",
    "eslint": "10.8.0",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-formatter-sarif": "github:iiiii7d/eslint-formatter-sarif",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "optionalDependencies": {
    "discord.js": "14.27.0"
  },
  "overrides": {
    "readdir-glob": "3.0.0",
    "glob": "13.0.6"
  },
  "packageManager": "pnpm@11.20.0"
}
