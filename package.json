{
  "name": "statustracker4",
  "version": "4.0.0-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint ${@:-.}",
    "lint:fix": "eslint --fix ${@:-.}",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}",
    "type-check": "pnpm run -r type-check",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:psql": "docker-compose exec postgres psql -U statustracker -d statustracker",
    "db:logs": "docker-compose logs",
    "dev": "pnpm run -r dev",
    "build": "pnpm run -r build"
  },
  "dependencies": {
    "@tsconfig/strictest": "2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nuxt/eslint": "1.17.0",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@12.22.0"
}
