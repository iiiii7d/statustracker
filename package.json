{
  "name": "statustracker4",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint ${@:-.}",
    "lint:fix": "eslint --fix ${@:-.}",
    "lint:sarif": "eslint -f @_7d/eslint-formatter-sarif --fix ${@:-.} || true",
    "format": "prettier --write ${@:-.}",
    "format:check": "prettier --check ${@:-.}",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:psql": "docker-compose exec postgres psql -U statustracker -d statustracker",
    "db:logs": "docker-compose logs"
  },
  "files": [
    "shared",
    "tsconfig.json"
  ],
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@tsconfig/strictest": "2.0.8",
    "canvas": "3.2.3",
    "consola": "3.4.2",
    "echarts": "6.1.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@_7d/eslint-formatter-sarif": "1.0.1",
    "@eslint/js": "10.0.1",
    "@nuxt/eslint": "1.17.0",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "readdir-glob": "3.0.0",
    "glob": "13.0.6"
  },
  "packageManager": "pnpm@12.5.1"
}
